# Shared base configuration for worker services to reduce duplication
x-snapshotter-base: &snapshotter-base
  build:
    context: .
    dockerfile: Dockerfile
  image: ${SNAPSHOTTER_IMAGE:-ghcr.io/powerloom/snapshotter-core:dockerify}
  networks:
    - ipfs-redis
  depends_on:
    snapshotter-local-collector:
      condition: service_healthy
      required: false
  volumes:
    - ./logs/snapshotter:/logs
    - ./config:/config
    - ./computes:/computes
    - ./snapshotter:/snapshotter
    - ./contrib:/contrib
    - ./poetry.lock:/poetry.lock
    - ./pyproject.toml:/pyproject.toml
  environment:
    # Reusable environment variables across services
    - SIGNER_ACCOUNT_ADDRESS
    - SIGNER_ACCOUNT_PRIVATE_KEY
    - SLOT_ID
    - SOURCE_RPC_URL
    - PROST_RPC_URL
    - IPFS_URL
    - IPFS_API_KEY
    - IPFS_API_SECRET
    - PROTOCOL_STATE_CONTRACT
    - DATA_MARKET_CONTRACT
    - LOCAL_COLLECTOR_PORT
    # Reporting configurations
    - NAMESPACE
    - TELEGRAM_REPORTING_URL
    - TELEGRAM_CHAT_ID
    # Redis configuration with optional password
    - REDIS_HOST=${REDIS_HOST:-redis}
    - REDIS_PORT=${REDIS_PORT:-6379}
    - REDIS_DB=${REDIS_DB:-0}
    - REDIS_PASSWORD
    # Optional S3 configuration for IPFS
    - IPFS_S3_CONFIG_ENABLED=${IPFS_S3_CONFIG_ENABLED:-false}
    - IPFS_S3_CONFIG_ENDPOINT_URL
    - IPFS_S3_CONFIG_BUCKET_NAME
    - IPFS_S3_CONFIG_ACCESS_KEY
    - IPFS_S3_CONFIG_SECRET_KEY
    - IPFS_UNPINNING_ENABLED=${IPFS_UNPINNING_ENABLED:-false}
    - IPFS_UNPINNING_AFTER=${IPFS_UNPINNING_AFTER:-86400}
    - GUNICORN_WORKERS=${GUNICORN_WORKERS:-5}
    - BLOCK_SHIFT_FOR_BITMAP_INDEX=${BLOCK_SHIFT_FOR_BITMAP_INDEX:-22400000}
    # MPP (Core API / gunicorn_core_launcher; ignored by other workers if unset)
    - MPP_ENABLED=${MPP_ENABLED:-false}
    # tempo = pympp/Tempo; signup_api = SQLite billing via bds-agenthub-billing-metering HTTP
    - MPP_BILLING_MODE=${MPP_BILLING_MODE:-tempo}
    # Canonical: MPP_SIGNUP_BILLING_BASE_URL. MPP_SIGNUP_BILLING_URL also works (see MppConfig validator).
    - MPP_SIGNUP_BILLING_BASE_URL=${MPP_SIGNUP_BILLING_BASE_URL:-}
    - MPP_SIGNUP_BILLING_URL=${MPP_SIGNUP_BILLING_URL:-}
    - MPP_INTERNAL_BILLING_SECRET=${MPP_INTERNAL_BILLING_SECRET:-}
    - MPP_CHARGE_AMOUNT=${MPP_CHARGE_AMOUNT:-0.01}
    - MPP_STREAM_AMOUNT=${MPP_STREAM_AMOUNT:-0.0001}
    - MPP_TEMPO_RPC_URL=${MPP_TEMPO_RPC_URL:-https://rpc.moderato.tempo.xyz}
    - MPP_TEMPO_RECIPIENT=${MPP_TEMPO_RECIPIENT:-}
    - MPP_TEMPO_CURRENCY=${MPP_TEMPO_CURRENCY:-}
    - MPP_TEMPO_CHAIN_ID=${MPP_TEMPO_CHAIN_ID:-42431}
    - MPP_SECRET_KEY=${MPP_SECRET_KEY:-}
    - MPP_PROTECTED_PATHS=${MPP_PROTECTED_PATHS:-/mpp/}
    - MPP_REALM=${MPP_REALM:-}
    # Free-route rate limits (non-/mpp/); Redis-backed (see PUBLIC_RATE_LIMIT_* in env.example)
    - PUBLIC_RATE_LIMIT_ENABLED=${PUBLIC_RATE_LIMIT_ENABLED:-true}
    - PUBLIC_RATE_LIMIT_RATE_PUBLIC=${PUBLIC_RATE_LIMIT_RATE_PUBLIC:-10/minute}
    - PUBLIC_RATE_LIMIT_RATE_AUTHENTICATED=${PUBLIC_RATE_LIMIT_RATE_AUTHENTICATED:-60/minute}
    - PUBLIC_RATE_LIMIT_KEY_PREFIX=${PUBLIC_RATE_LIMIT_KEY_PREFIX:-rl:public:}
    - PUBLIC_RATE_LIMIT_AUTH_HEADER=${PUBLIC_RATE_LIMIT_AUTH_HEADER:-X-API-KEY}
    - PUBLIC_RATE_LIMIT_SKIP_PATHS=${PUBLIC_RATE_LIMIT_SKIP_PATHS:-/health,/docs,/openapi.json,/redoc}
  extra_hosts:
    - "host.docker.internal:host-gateway"
  healthcheck:
    # Use CMD-SHELL to evaluate hostname within the container's shell
    # Make sure the path /snapshotter/health_ping.py is correct inside the container
    test: ["CMD-SHELL", "poetry run python -m snapshotter.health_ping $$(hostname) || exit 1"]
    interval: 30s
    timeout: 10s
    retries: 3
    start_period: 60s # Give container time to start and report first health status
  restart: unless-stopped
  logging:
    driver: "json-file"
    options:
      max-size: ${DOCKER_LOG_MAX_SIZE:-50m}
      max-file: ${DOCKER_LOG_MAX_FILES:-3}
  ulimits:
      nofile:
        soft: 1000000
        hard: 1000000
      memlock:
        soft: -1
        hard: -1
      nproc:
        soft: 32768
        hard: 32768

services:

  rate-limiter:
    image: ${RATE_LIMITER_IMAGE:-ghcr.io/powerloom/rate-limiter:dockerify}
    networks:
      - ipfs-redis
    environment:
      - DEFAULT_RATE_LIMIT=${DEFAULT_RATE_LIMIT:-1000}
    command: poetry run uvicorn app:app --host 0.0.0.0 --port 8000
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: ${DOCKER_LOG_MAX_SIZE:-50m}
        max-file: ${DOCKER_LOG_MAX_FILES:-3}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
  # Local Collector Service
  snapshotter-local-collector:
    image: ${SNAPSHOTTER_COLLECTOR_IMAGE:-ghcr.io/powerloom/snapshotter-lite-local-collector:dockerify}
    profiles: ["local-collector"]
    ports:
      - "0.0.0.0:${LOCAL_COLLECTOR_P2P_PORT:-9100}:${LOCAL_COLLECTOR_P2P_PORT:-9100}"
      - "127.0.0.1:${LOCAL_COLLECTOR_PORT:-50051}:${LOCAL_COLLECTOR_PORT:-50051}"
      - "127.0.0.1:${LOCAL_COLLECTOR_HEALTH_CHECK_PORT:-8080}:${LOCAL_COLLECTOR_HEALTH_CHECK_PORT:-8080}"
    networks:
      - ipfs-redis
    volumes:
      - ./logs/local-collector:/root/.pm2/logs
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:${LOCAL_COLLECTOR_HEALTH_CHECK_PORT:-8080}/ready"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 5s # Service ready as soon as HTTP server starts (mesh forms in background)
    environment:
      # Use a secrets management approach for sensitive information
      # Consider using Docker secrets or .env file for these
      - SIGNER_ACCOUNT_ADDRESS
      - SIGNER_ACCOUNT_PRIVATE_KEY
      - IPFS_URL
      - IPFS_API_KEY
      - IPFS_API_SECRET
      - PROTOCOL_STATE_CONTRACT
      - DATA_MARKET_CONTRACT
      - PROST_RPC_URL
      - PROST_CHAIN_ID
      - REDIS_HOST=${REDIS_HOST:-redis}
      - REDIS_PORT=${REDIS_PORT:-6379}
      - LOCAL_COLLECTOR_PORT
      - LOCAL_COLLECTOR_P2P_PORT=${LOCAL_COLLECTOR_P2P_PORT:-9100}
      - LOCAL_COLLECTOR_PRIVATE_KEY
      # Configurable stream processing parameters with sensible defaults
      - BLOCK_TIME=${BLOCK_TIME:-15}
      - MAX_STREAM_POOL_SIZE=${MAX_STREAM_POOL_SIZE:-100}
      - STREAM_HEALTH_CHECK_TIMEOUT_MS=${STREAM_HEALTH_CHECK_TIMEOUT_MS:-5000}
      - STREAM_WRITE_TIMEOUT_MS=${STREAM_WRITE_TIMEOUT_MS:-3000}
      - MAX_WRITE_RETRIES=${MAX_WRITE_RETRIES:-3}
      - MAX_CONCURRENT_WRITES=${MAX_CONCURRENT_WRITES:-10}
      - STREAM_POOL_HEALTH_CHECK_INTERVAL=${STREAM_POOL_HEALTH_CHECK_INTERVAL:-60000}
      - DATA_MARKET_IN_REQUEST=${DATA_MARKET_IN_REQUEST:-false}
      - CONNECTION_REFRESH_INTERVAL_SEC=${CONNECTION_REFRESH_INTERVAL_SEC:-300}
      - WRITE_SEMAPHORE_TIMEOUT_SEC=${WRITE_SEMAPHORE_TIMEOUT_SEC:-5}
      # Gossipsub configuration
      - RENDEZVOUS_POINT=${RENDEZVOUS_POINT:-powerloom-snapshot-sequencer-network}
      - GOSSIPSUB_SNAPSHOT_SUBMISSION_PREFIX=${GOSSIPSUB_SNAPSHOT_SUBMISSION_PREFIX:-/powerloom/snapshot-submissions}
      - BOOTSTRAP_NODE_ADDRS
      - PUBLIC_IP
      - CONN_MANAGER_LOW_WATER=${CONN_MANAGER_LOW_WATER:-10000}
      - CONN_MANAGER_HIGH_WATER=${CONN_MANAGER_HIGH_WATER:-40000}
      - DOCKER_BRIDGE_GATEWAY_IPS=${DOCKER_BRIDGE_GATEWAY_IPS:-}
      # Stream Pool Configuration (for centralized sequencer)
      - MAX_STREAM_QUEUE_SIZE=${MAX_STREAM_QUEUE_SIZE:-1000}
      # Centralized Sequencer Control
      # Set to "false" to disable all submissions to centralized sequencer (mesh-only mode)
      # Set to "true" to enable dual submission (both centralized sequencer and mesh)
      - CENTRALIZED_SEQUENCER_ENABLED=${CENTRALIZED_SEQUENCER_ENABLED:-true}
      # Mesh Submission Concurrency Controls
      # Rate limiting for mesh submissions to prevent overwhelming the gossipsub network
      - MESH_SUBMISSION_RATE_LIMIT=${MESH_SUBMISSION_RATE_LIMIT:-100}
      - MESH_SUBMISSION_BURST_SIZE=${MESH_SUBMISSION_BURST_SIZE:-200}
      # Maximum concurrent mesh publish operations (goroutine limit)
      - MAX_MESH_PUBLISH_GOROUTINES=${MAX_MESH_PUBLISH_GOROUTINES:-500}
      # Maximum queued mesh submissions when rate limited
      - MESH_PUBLISH_QUEUE_SIZE=${MESH_PUBLISH_QUEUE_SIZE:-1000}
      # Delay between processing queued messages to smooth out bursts (milliseconds)
      - MESH_QUEUE_PROCESSING_DELAY_MS=${MESH_QUEUE_PROCESSING_DELAY_MS:-10}
      # Timeout for rate limiter waits when processing queued messages (seconds)
      - MESH_RATE_LIMITER_TIMEOUT_SEC=${MESH_RATE_LIMITER_TIMEOUT_SEC:-10}
      # Gossipsub Buffer Configuration
      # Validation queue size for gossipsub (increased from default to prevent buffer overflow)
      - GOSSIPSUB_VALIDATE_QUEUE_SIZE=${GOSSIPSUB_VALIDATE_QUEUE_SIZE:-512}
      # Number of validation workers for gossipsub (increased from default for better throughput)
      - GOSSIPSUB_VALIDATE_WORKERS=${GOSSIPSUB_VALIDATE_WORKERS:-8}
      # Slack alerting for local collector (mesh monitoring, errors, etc.)
      - SLACK_WEBHOOK_URL=${LOCAL_COLLECTOR_SLACK_WEBHOOK_URL}
      # Health check server port
      - HEALTH_CHECK_PORT=${LOCAL_COLLECTOR_HEALTH_CHECK_PORT:-8080}
      # Log level (inherits from core-edge LOG_LEVEL, defaults to info)
      - LOG_LEVEL=${LOG_LEVEL:-info}
    restart: on-failure:10
    logging:
      driver: "json-file"
      options:
        max-size: ${DOCKER_LOG_MAX_SIZE:-50m}
        max-file: ${DOCKER_LOG_MAX_FILES:-3}
    # Increase file descriptors limit for better performance
    ulimits:
      nofile:
        soft: 1000000
        hard: 1000000
      memlock:
        soft: -1
        hard: -1
      nproc:
        soft: 32768
        hard: 32768
  # Worker services using the base configuration
  system-event-detector:
    <<: *snapshotter-base
    command: bash -c "bash init_processes.sh system_event_detector"
    depends_on:
      - processor-distributor
    profiles: ["old"]
  processor-distributor:
    <<: *snapshotter-base
    command: bash -c "bash snapshotter_autofill.sh &&bash init_processes.sh processor_distributor"
  unified-cache:
    <<: *snapshotter-base
    command: bash -c "bash init_processes.sh unified_cache"
    depends_on:
      - processor-distributor
  aggregation-worker:
    <<: *snapshotter-base
    command: bash -c "bash init_processes.sh utils.aggregation_worker"
    depends_on:
      - processor-distributor
    deploy:
      replicas: ${AGGREGATION_WORKER_REPLICAS:-6}
  ipfs-unpinning-worker:
    <<: *snapshotter-base
    command: bash -c "bash init_processes.sh utils.ipfs_unpinning_worker"
    depends_on:
      - processor-distributor
  # Core API Service
  core-api:
    <<: *snapshotter-base
    expose:
      - ${CORE_API_PORT:-9003}
    ports:
      - ${CORE_API_PORT:-9003}:${CORE_API_PORT:-9003}
    command: bash -c "bash init_processes.sh gunicorn_core_launcher"
    depends_on:
      - processor-distributor
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:${CORE_API_PORT:-9003}/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    ulimits:
      nofile:
        soft: 1000000
        hard: 1000000
      memlock:
        soft: -1
        hard: -1
      nproc:
        soft: 32768
        hard: 32768 
  block_fetcher:
    # Build context pointing to the parent directory and then BlockFetcher
    build:
      context: snapshotter-periphery-blockfetcher
      dockerfile: Dockerfile
    networks:
      - ipfs-redis
    environment:
      - NAMESPACE
      - SOURCE_RPC_URL=${SOURCE_RPC_URL}
      - SOURCE_RPC_RATE_LIMIT=${DEFAULT_RATE_LIMIT:-1000}
      - SOURCE_RPC_RETRY=${DEFAULT_RPC_RETRY:-3}
      - SOURCE_RPC_TIMEOUT=${DEFAULT_RPC_TIMEOUT:-10}
      - SOURCE_RPC_POLLING_INTERVAL=${DEFAULT_POLLING_INTERVAL:-10}
      - REDIS_HOST=${REDIS_HOST:-redis}
      - REDIS_PORT=${REDIS_PORT:-6379}
      - REDIS_DB=${REDIS_DB:-0}
      - REDIS_PASSWORD=${REDIS_PASSWORD:-}
      - REDIS_SSL=${REDIS_SSL:-false}
      - REDIS_CLUSTER=${REDIS_CLUSTER:-false}
      - REDIS_MAX_BLOCKS=${REDIS_MAX_BLOCKS:-100}
      - REDIS_MAX_TIMESTAMPS=${REDIS_MAX_TIMESTAMPS:-50400}
      - REDIS_TTL_SECONDS=${REDIS_TTL_SECONDS:-86400}
      - LOG_DEBUG=${LOG_DEBUG:-false}
      - LOG_TO_FILES=${LOG_TO_FILES:-false}
      - LOG_LEVEL=${LOG_LEVEL:-DEBUG}
      - TEST_MODE=${TEST_MODE:-false}
      - HTTPX_POOL_TIMEOUT=${HTTPX_POOL_TIMEOUT:-5}
      - HTTPX_CONNECT_TIMEOUT=${HTTPX_CONNECT_TIMEOUT:-5}
      - HTTPX_READ_TIMEOUT=${HTTPX_READ_TIMEOUT:-5}
      - HTTPX_WRITE_TIMEOUT=${HTTPX_WRITE_TIMEOUT:-5}
      - REPORTING_SLACK_URL=${REPORTING_SLACK_URL:-}
      - REPORTING_SERVICE_URL=${REPORTING_SERVICE_URL:-}
      - REPORTING_TELEGRAM_URL=${REPORTING_TELEGRAM_URL:-}
      - REPORTING_TELEGRAM_CHAT_ID=${REPORTING_TELEGRAM_CHAT_ID:-}
      - REPORTING_MIN_INTERVAL=${REPORTING_MIN_INTERVAL:-10}
    volumes:
      # Volume path relative to the docker-compose file location
      - ./logs/snapshotter-periphery-blockfetcher:/app/logs
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: ${DOCKER_LOG_MAX_SIZE:-50m}
        max-file: ${DOCKER_LOG_MAX_FILES:-3}
    profiles: ["new"]
  tx_processor:
    # Build context pointing to the parent directory and then txprocessor
    build:
      context: snapshotter-periphery-txprocessor
      dockerfile: Dockerfile
    networks:
      - ipfs-redis
    environment:
      - NAMESPACE
      - RPC_URL=${SOURCE_RPC_URL}
      - RPC_RETRY=${DEFAULT_RPC_RETRY:-3}
      - RPC_TIMEOUT=${DEFAULT_RPC_TIMEOUT:-10}
      - REDIS_HOST=${REDIS_HOST:-redis}
      - REDIS_PORT=${REDIS_PORT:-6379}
      - REDIS_DB=${REDIS_DB:-0}
      - REDIS_PASSWORD=${REDIS_PASSWORD:-}
      - REDIS_SSL=${REDIS_SSL:-false}
      - REDIS_CLUSTER=${REDIS_CLUSTER:-false}
      - REDIS_MAX_BLOCKS=${REDIS_MAX_BLOCKS:-100}
      - REDIS_TTL_SECONDS=${REDIS_TTL_SECONDS:-86400}
      - LOG_DEBUG=${LOG_DEBUG:-false}
      - LOG_TO_FILES=${LOG_TO_FILES:-false}
      - LOG_LEVEL=${LOG_LEVEL:-DEBUG}
      - PROCESSOR_QUEUE_KEY=${PROCESSOR_QUEUE_KEY:-}
      - PROCESSOR_BLOCK_TIMEOUT=${PROCESSOR_BLOCK_TIMEOUT:-}
      - EVENT_FILTER_CONFIG_PATH=${EVENT_FILTER_CONFIG_PATH:-/app/shared_config/event_filters.example.json}
      - WETH_ADDRESS=${WETH_ADDRESS:-}
    profiles: ["new"]
    deploy:
      replicas: ${TRANSACTION_PROCESSOR_REPLICAS:-3}
    volumes:
      - ./config:/app/shared_config:ro
      - ./computes:/app/computes:ro
      - ./logs/snapshotter-periphery-txprocessor:/app/logs
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: ${DOCKER_LOG_MAX_SIZE:-50m}
        max-file: ${DOCKER_LOG_MAX_FILES:-3}
    ulimits:
      nofile:
        soft: 1000000
        hard: 1000000
      memlock:
        soft: -1
        hard: -1
      nproc:
        soft: 32768
        hard: 32768
  epoch_syncer:
    build:
      context: snapshotter-periphery-epochsyncer
      dockerfile: Dockerfile
    networks:
      - ipfs-redis
    environment:
      - NAMESPACE
      - INSTANCE_ID=${SIGNER_ACCOUNT_ADDRESS}
      - SOURCE_RPC_URL=${SOURCE_RPC_URL}
      - SOURCE_RPC_RATE_LIMIT=${DEFAULT_RATE_LIMIT:-1000}
      - SOURCE_RPC_MAX_RETRIES=${DEFAULT_RPC_RETRY:-3}
      - SOURCE_RPC_TIMEOUT=${DEFAULT_RPC_TIMEOUT:-10}
      - SOURCE_RPC_POLLING_INTERVAL=${DEFAULT_POLLING_INTERVAL:-10}
      - POWERLOOM_RPC_URL=${PROST_RPC_URL}
      - POWERLOOM_RPC_RATE_LIMIT=${DEFAULT_RATE_LIMIT:-1000}
      - POWERLOOM_RPC_RETRY=${DEFAULT_RPC_RETRY:-3}
      - POWERLOOM_RPC_TIMEOUT=${DEFAULT_RPC_TIMEOUT:-10}
      - POWERLOOM_RPC_POLLING_INTERVAL=${DEFAULT_POLLING_INTERVAL:-10}
      - REDIS_HOST=${REDIS_HOST:-redis}
      - REDIS_PORT=${REDIS_PORT:-6379}
      - REDIS_DB=${REDIS_DB:-0}
      - REDIS_PASSWORD=${REDIS_PASSWORD:-}
      - REDIS_SSL=${REDIS_SSL:-false}
      - REDIS_CLUSTER_MODE=${REDIS_CLUSTER:-false}
      - PROTOCOL_STATE_CONTRACT_ADDRESS=${PROTOCOL_STATE_CONTRACT}
      - DATA_MARKET_CONTRACT_ADDRESS=${DATA_MARKET_CONTRACT}
      - POLLING_INTERVAL=${DEFAULT_POLLING_INTERVAL:-10}
      - LOG_LEVEL=${LOG_LEVEL:-DEBUG}
      - WRITE_LOGS_TO_FILES=${LOG_TO_FILES:-false}
      - DEBUG_MODE=${DEBUG_MODE:-false}
      - RATE_LIMITER_HOST=${RATE_LIMITER_HOST:-rate-limiter}
      - RATE_LIMITER_PORT=${RATE_LIMITER_PORT:-8000}
    depends_on:
      - rate-limiter
    profiles: ["new"]
    volumes:
      - ./logs/snapshotter-periphery-epochsyncer:/app/logs
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: ${DOCKER_LOG_MAX_SIZE:-50m}
        max-file: ${DOCKER_LOG_MAX_FILES:-3}
  # IPFS Service with improved configuration
  ipfs:
    image: ipfs/kubo:master-latest
    profiles: ["ipfs"]
    environment:
      - IPFS_PROFILE=server
      # Configurable cleanup parameters
      - DATA_CLEANUP_DAYS=${IPFS_DATA_CLEANUP_DAYS:-3}
      - CLEANUP_SCHEDULE=${IPFS_CLEANUP_SCHEDULE:-0 */3 * * *}
      - LIBP2P_FORCE_PNET=0
      - IPFS_ROUTING=dhtclient
    entrypoint: >
      /bin/sh -c '
      exec /sbin/tini -- /usr/local/bin/start_ipfs daemon --migrate=true --agent-version-suffix=docker
      '
    volumes:
      - ./ipfs-data:/data/ipfs
      - ./ipfs-export:/export
    ports:
      - "4001:4001"  # Swarm listening port
      - "127.0.0.1:5001:5001"  # API server
      - "127.0.0.1:8080:8080"  # Gateway
    healthcheck:
      test: ["CMD", "ipfs", "id"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: ${DOCKER_LOG_MAX_SIZE:-50m}
        max-file: ${DOCKER_LOG_MAX_FILES:-3}
    ulimits:
      nofile:
        soft: 1000000
        hard: 1000000
      memlock:
        soft: -1
        hard: -1
      nproc:
        soft: 32768
        hard: 32768

  # Redis Service
  redis:
    image: "redis:alpine"
    profiles: ["redis"]
    command: redis-server --appendonly yes --maxmemory ${REDIS_MAX_MEMORY:-512mb} --maxmemory-policy ${REDIS_MAXMEMORY_POLICY:-allkeys-lru}
    expose:
      - 6379
    ports:
      - 6379:6379
    healthcheck:
      test: ["CMD", "sh", "-c", "redis-cli ping | grep -q PONG && ! redis-cli info persistence | grep -q 'loading:1'"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    restart: on-failure
    logging:
      driver: "json-file"
      options:
        max-size: ${DOCKER_LOG_MAX_SIZE:-50m}
        max-file: ${DOCKER_LOG_MAX_FILES:-3}
    volumes:
      - ./redis-data:/data
    # Add optional password and memory configurations
    environment:
      - REDIS_PASSWORD
# Dynamic worker services will be inserted here by generate_worker_services.py
# DO NOT EDIT BELOW THIS LINE - DYNAMIC CONFIGURATION
# Generated worker services start
# Generated worker services end
networks:
  ipfs-redis:
    external: true