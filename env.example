# Required
SOURCE_RPC_URL=<source-rpc-url>
SIGNER_ACCOUNT_ADDRESS=<signer-account-address>
SIGNER_ACCOUNT_PRIVATE_KEY=<signer-account-private-key>
SLOT_ID=<slot-id>
SNAPSHOT_CONFIG_REPO=https://github.com/powerloom/snapshotter-configs
SNAPSHOT_CONFIG_REPO_BRANCH=eth_uniswapv2_core
SNAPSHOTTER_COMPUTE_REPO=https://github.com/powerloom/snapshotter-computes
SNAPSHOTTER_COMPUTE_REPO_BRANCH=eth_uniswapv2_core
SUBNET_THIRD_OCTET=1
# local collector envs: begin
# Local Collector - Stream pool configuration
MAX_STREAM_POOL_SIZE=50
MAX_STREAM_QUEUE_SIZE=1000
STREAM_HEALTH_CHECK_TIMEOUT_MS=5000
STREAM_WRITE_TIMEOUT_MS=5000
MAX_WRITE_RETRIES=5
MAX_CONCURRENT_WRITES=1000
STREAM_POOL_HEALTH_CHECK_INTERVAL=60000
CONNECTION_REFRESH_INTERVAL_SEC=300
WRITE_SEMAPHORE_TIMEOUT_SEC=5
DATA_MARKET_IN_REQUEST=true
# Local Collector - Centralized Sequencer Control
# Set to "false" to disable all submissions to centralized sequencer (mesh-only mode)
# Set to "true" to enable dual submission (both centralized sequencer and mesh)
CENTRALIZED_SEQUENCER_ENABLED=true
# Local Collector - Mesh Submission Concurrency Controls
# Rate limiting for mesh submissions to prevent overwhelming the gossipsub network
MESH_SUBMISSION_RATE_LIMIT=100
MESH_SUBMISSION_BURST_SIZE=200
# Maximum concurrent mesh publish operations (goroutine limit)
MAX_MESH_PUBLISH_GOROUTINES=500
# Maximum queued mesh submissions when rate limited
MESH_PUBLISH_QUEUE_SIZE=1000
# Delay between processing queued messages to smooth out bursts (milliseconds)
MESH_QUEUE_PROCESSING_DELAY_MS=10
# Timeout for rate limiter waits when processing queued messages (seconds)
MESH_RATE_LIMITER_TIMEOUT_SEC=10
# Local Collector - Gossipsub Buffer Configuration
# Validation queue size for gossipsub (increased from default to prevent buffer overflow)
GOSSIPSUB_VALIDATE_QUEUE_SIZE=512
# Number of validation workers for gossipsub (increased from default for better throughput)
GOSSIPSUB_VALIDATE_WORKERS=8
# Local Collector - P2P Configuration
LOCAL_COLLECTOR_P2P_PORT=9100
LOCAL_COLLECTOR_PRIVATE_KEY=
BOOTSTRAP_NODE_ADDRS=
RENDEZVOUS_POINT=powerloom-snapshot-sequencer-network
GOSSIPSUB_SNAPSHOT_SUBMISSION_PREFIX=/powerloom/snapshot-submissions
PUBLIC_IP=
CONN_MANAGER_LOW_WATER=10000
CONN_MANAGER_HIGH_WATER=40000
# Local Collector - Slack alerting (mesh monitoring, errors, etc.) (optional)
LOCAL_COLLECTOR_SLACK_WEBHOOK_URL=
# Local Collector - Health check server port for mesh readiness monitoring (default: 8080)
LOCAL_COLLECTOR_HEALTH_CHECK_PORT=8080
# local collector envs: end
PROST_RPC_URL=https://rpc-v2.powerloom.network
PROTOCOL_STATE_CONTRACT=0x000AA7d3a6a2556496f363B59e56D9aA1881548F
DATA_MARKET_CONTRACT=0x21cb57C1f2352ad215a463DD867b838749CD3b8f
NAMESPACE=UNISWAPV3
PROST_CHAIN_ID=7869
DEFAULT_RATE_LIMIT=10
WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
# Optional
IPFS_URL=/dns/ipfs/tcp/5001
IPFS_API_KEY=
IPFS_API_SECRET=
DASHBOARDS_ENABLED=
DEVMODE=false
IPFS_S3_CONFIG_ENABLED=false
IPFS_S3_CONFIG_ENDPOINT_URL=
IPFS_S3_CONFIG_BUCKET_NAME=
IPFS_S3_CONFIG_ACCESS_KEY=
IPFS_S3_CONFIG_SECRET_KEY=
SNAPSHOT_WORKER_REPLICAS=6
AGGREGATION_WORKER_REPLICAS=6
TELEGRAM_REPORTING_URL=https://tg-testing.powerloom.io/
TELEGRAM_CHAT_ID=<telegram-chat-id>
IPFS_UNPINNING_ENABLED=false
IPFS_UNPINNING_AFTER=86400

SNAPSHOTTER_PERIPHERY_BLOCKFETCHER_BRANCH=feat/blockdetails-preloader
SNAPSHOTTER_PERIPHERY_TXPROCESSOR_BRANCH=feat/preloader-initial
SNAPSHOTTER_PERIPHERY_EPOCHSYNCER_BRANCH=feat/basic-sync
RATE_LIMITER_BRANCH=main

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_CLUSTER=false
LOG_DEBUG=false
LOG_TO_FILES=false
LOG_LEVEL=DEBUG
TEST_MODE=true
HTTPX_POOL_TIMEOUT=5
HTTPX_CONNECT_TIMEOUT=5
HTTPX_READ_TIMEOUT=5
HTTPX_WRITE_TIMEOUT=5

# Processor Settings
PROCESSOR_QUEUE_KEY=pending_transactions
PROCESSOR_BLOCK_TIMEOUT=0 # 0 = Block indefinitely
TRANSACTION_PROCESSOR_REPLICAS=3
REPORTING_SLACK_URL=
REPORTING_SERVICE_URL=
REPORTING_TELEGRAM_URL=
REPORTING_TELEGRAM_CHAT_ID=
REPORTING_MIN_INTERVAL=60
USE_NEW_SETUP=true

# Event Filter Settings
EVENT_FILTER_CONFIG_PATH=/app/shared_config/event_filters.example.json

REDIS_MAX_BLOCKS=64
REDIS_MAX_TIMESTAMPS=50400
REDIS_TTL_SECONDS=86400
RATE_LIMITER_HOST=rate-limiter
RATE_LIMITER_PORT=8000
BLOCK_SHIFT_FOR_BITMAP_INDEX=22400000
GUNICORN_WORKERS=5

